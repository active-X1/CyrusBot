# ─────────────────────────────────────────────────────────────
# CyrusBot configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to version control.
# ─────────────────────────────────────────────────────────────

# Bot identity
BOT_NAME=CyrusBot
BOT_AUTHOR=Active X
GITHUB_USERNAME=active-X1

# Command prefix (e.g. "." means commands look like ".ping")
PREFIX=.

# Your WhatsApp number in international format, digits only, no "+".
# Example: 15551234567
OWNER_NUMBER=15551234567

# Comma-separated list of additional numbers allowed to use owner-only
# commands (optional). Same format as OWNER_NUMBER.
SUDO_NUMBERS=

# Authentication method:
#   qr             -> scan a QR code in the terminal
#   pairing-code   -> receive an 8-character pairing code instead
#                      ("pairing" also works as a shorthand)
# Leave this UNSET to get an interactive setup menu instead (only works
# when the bot is run in a real terminal with a TTY, e.g. locally - NOT
# on most hosting platforms like Render, which don't provide one; on
# those, always set this explicitly).
AUTH_METHOD=qr

# Only used when AUTH_METHOD=pairing-code. Must match OWNER_NUMBER format.
PAIRING_NUMBER=15551234567

# ─────────────────────────────────────────────────────────────
# AI mode (Groq)
# Get a free API key at https://console.groq.com
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_DAILY_LIMIT=10

# ─────────────────────────────────────────────────────────────
# Encryption (used by .encrypt / .decrypt as a fallback passphrase
# when the user doesn't supply one inline). Set this to something
# long and random. Do not reuse this value anywhere else.
# ─────────────────────────────────────────────────────────────
DEFAULT_CIPHER_PASSPHRASE=

# Logging level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# CyrusBot configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to version control.
# ─────────────────────────────────────────────────────────────

# Bot identity
BOT_NAME=activeX
BOT_AUTHOR=Cyrus Akacha Cyprian
GITHUB_USERNAME=active-X1

# Command prefix (e.g. "." means commands look like ".ping")
PREFIX=.

# Extra prefixes that ALSO trigger every command (comma-separated).
# Default "!" means both ".menu" and "!menu" work.
EXTRA_PREFIXES=!

# Your WhatsApp number in international format, digits only, no "+".
# Example: 15551234567
OWNER_NUMBER=15551234567

# Comma-separated list of additional numbers allowed to use owner-only
# commands (optional). Same format as OWNER_NUMBER.
SUDO_NUMBERS=

# Login: when you run the bot in a terminal, it always ASKS whether to pair
# with a phone number or a QR code whenever a login is needed.
# Where there is no keyboard (e.g. Render) it can't ask, so it uses:
#   AUTH_METHOD=pairing-code  (alias: pairing)  or  AUTH_METHOD=qr
# If AUTH_METHOD is unset but PAIRING_NUMBER is set, phone pairing is used.
#AUTH_METHOD=pairing-code

# Only used when AUTH_METHOD=pairing-code. Must match OWNER_NUMBER format.
PAIRING_NUMBER=15551234567

# ─────────────────────────────────────────────────────────────
# AI mode (OpenRouter)
# Create a key at https://openrouter.ai/keys
# OPENROUTER_MODEL: the default "openrouter/free" lets OpenRouter pick an
# available FREE model for you (free model names change often). To use a
# specific model, put its id here, e.g. "google/gemma-4-31b-it:free".
# Note: free models have lower rate limits, and some free hosts may keep
# or train on prompts - don't expect privacy for sensitive chats.
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_DAILY_LIMIT=10

# .imagine uses OpenRouter's Nano Banana (a PAID model - your OpenRouter
# account needs credits). IMAGINE_DAILY_LIMIT = images per chat per day.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
IMAGINE_DAILY_LIMIT=5

# ─────────────────────────────────────────────────────────────
# Encryption (.encrypt / .decrypt)
# You do NOT need to set anything: the bot generates its own key the
# first time it's needed and stores it in database/cipher-key.json.
# OPTIONAL: set CIPHER_KEY to pin the key yourself. Recommended on
# hosts that wipe the disk on redeploy (e.g. Render without a
# persistent disk), otherwise old encrypted messages can't be decrypted.
# ─────────────────────────────────────────────────────────────
CIPHER_KEY=

# Logging level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Games (.snakegame / .aimgame)
# The bot serves the games itself and sends a link. On Render, deploy
# as a *Web Service* and RENDER_EXTERNAL_URL is detected automatically.
# Elsewhere, set PUBLIC_URL to your server's public https address.
# If no public URL exists, the bot sends the game as an .html file.
# PORT is set by Render automatically; defaults to 3000 locally.
# ─────────────────────────────────────────────────────────────
PUBLIC_URL=

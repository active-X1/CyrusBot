# Secrets / environment
.env
.env.*
!.env.example

# WhatsApp authentication / session data (NEVER commit these)
sessions/
!sessions/.gitkeep

# Runtime data & local "database"
database/*.json
!database/.gitkeep

# Logs (may contain message content / sensitive info)
logs/
!logs/.gitkeep
*.log

# Temp / downloaded / generated media
temp/*
!temp/.gitkeep
downloads/*
!downloads/.gitkeep
media/*
!media/.gitkeep

# Node
node_modules/
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
